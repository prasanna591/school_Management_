{
  "name": "smartschool",
  "version": "0.1.0",
  "private": true,
  "description": "SmartSchool - School Management System (Web, Android, iOS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @smartschool/backend",
    "dev:backend": "npm run dev -w @smartschool/backend",
    "build": "npm run build -w @smartschool/shared && npm run build -w @smartschool/backend",
    "build:shared": "npm run build -w @smartschool/shared",
    "start": "npm run start -w @smartschool/backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "db:generate": "npm run prisma:generate -w @smartschool/backend",
    "db:migrate": "npm run prisma:migrate -w @smartschool/backend",
    "db:deploy": "npm run prisma:deploy -w @smartschool/backend",
    "db:seed": "npm run prisma:seed -w @smartschool/backend",
    "db:seed:demo": "npm run prisma:seed:demo -w @smartschool/backend",
    "db:studio": "npm run prisma:studio -w @smartschool/backend",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "prepare": "npm run build:shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
