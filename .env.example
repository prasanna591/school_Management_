# =============================================================================
# SmartSchool - Environment variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` at the repository root and fill in real values:
#     cp .env.example .env        (Linux/macOS)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# NEVER commit the real `.env` file. Generate strong secrets with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Database (MySQL) --------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://smartschool:CHANGE_ME_DB_PASSWORD@localhost:3306/smartschool

# Credentials used by docker-compose to provision the local MySQL container.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=smartschool
MYSQL_USER=smartschool
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Authentication ----------------------------------------------------------
# Each secret MUST be at least 32 characters. Use different values in prod.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS_LONG
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_CHARS_LONG
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Relax request throttling for instructor-led demos where many devices share
# one NAT address. Never enable this in production.
DEMO_MODE=false

# Set to true only when the API sits behind a reverse proxy (nginx, a load
# balancer). Trusting a proxy otherwise lets clients spoof X-Forwarded-For.
TRUST_PROXY=false

# --- Seed (optional) ---------------------------------------------------------
# If omitted, the seed script generates a random password and prints it once.
SEED_SUPER_ADMIN_EMAIL=superadmin@smartschool.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_SCHOOL_NAME=SmartSchool Demo Academy
