{
  "name": "@smartschool/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run android",
    "ios": "expo run ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "~6.6.1",
    "@react-navigation/drawer": "~6.7.2",
    "@react-navigation/native": "~6.1.18",
    "@react-navigation/stack": "~6.0.11",
    "@smartschool/shared": "*",
    "expo": "~52.0.0",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-secure-store": "~14.0.1",
    "lucide-react-native": "1.57.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "~29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "18.3.18",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lucide-react-native|@smartschool/shared))"
    ]
  }
}
